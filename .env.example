# Chaîne de connexion PostgreSQL — Neon, Supabase, ou Vercel Postgres.
# Exemple (Neon) : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=""

# Clé secrète utilisée pour signer les sessions admin.
# Génère une valeur aléatoire, par exemple avec : openssl rand -base64 32
SESSION_SECRET=""

# Compte admin créé par "npm run db:seed" — change ces valeurs avant de lancer le seed.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-moi"

# Token Vercel Blob — nécessaire pour que l'upload de fichiers (images, CV,
# certificats) fonctionne. Voir le README, section "Activer l'upload de fichiers".
BLOB_READ_WRITE_TOKEN=""
